<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/ltBackground" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Phone Usage" android:textSize="24sp" android:textStyle="bold"
            android:textColor="?attr/ltTextPrimary" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="See which apps are eating your time today."
            android:textSize="14sp" android:textColor="?attr/ltTextSecondary"
            android:layout_marginBottom="20dp" />

        <Button android:id="@+id/refreshUsageButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Refresh Usage Data"
            android:backgroundTint="?attr/ltAccent" android:textColor="?attr/ltOnAccent"
            android:layout_marginBottom="16dp" />

        <TextView android:id="@+id/phoneUsageText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Tap refresh to load..."
            android:textSize="15sp" android:textColor="?attr/ltTextPrimary"
            android:padding="16dp" android:background="?attr/ltSurface"
            android:elevation="2dp" />

    </LinearLayout>
</ScrollView>